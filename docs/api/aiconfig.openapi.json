  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ConfigSummary": {
        "type": "object",
        "required": [
          "id",
          "owner_type",
          "owner_id",
          "visibility",
          "is_selected",
          "name",
          "provider_name",
          "base_url",
          "model_name",
          "created_by",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "owner_type": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "group"
            ]
          },
          "owner_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "shared"
            ]
          },
          "is_selected": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "provider_name": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "model_name": {
            "type": "string"
          },
          "created_by": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateConfig": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner_type": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "group"
            ]
          },
          "owner_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "shared"
            ]
          },
          "is_selected": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "provider_name": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "model_name": {
            "type": "string"
          },
          "api_key": {
            "type": "string",
            "writeOnly": true
          }
        },
        "description": "创建者、主键与更新时间由服务端维护；归属字段沿用当前业务行为。"
      },
      "UpdateConfig": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "shared"
            ]
          },
          "is_selected": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "provider_name": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "model_name": {
            "type": "string"
          },
          "api_key": {
            "type": "string",
            "writeOnly": true
          }
        },
        "description": "仅修改实际提交的白名单字段；false 正常更新；null 视为未提交；空对象不修改更新时间；连接字符串不得为空。"
      },
      "ModelsInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "config_id": {
            "type": "integer",
            "minimum": 0
          },
          "base_url": {
            "type": "string"
          },
          "api_key": {
            "type": "string",
            "writeOnly": true
          },
          "provider_name": {
            "type": "string"
          }
        },
        "description": "config_id 非零时须有管理权限；省略 api_key 仅可使用原地址和原提供商的保存密钥。"
      },
      "Provider": {
        "type": "object",
        "required": [
          "id",
          "name",
          "base_url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          }
        }
      }
    }
  }
