# 操作系统生成文件
.DS_Store
._*
Thumbs.db
Desktop.ini

# 编辑器本机配置与临时文件
.idea/
.vscode/
*.swp
*.swo
*~

# 本机环境变量；示例配置保留
.env
.env.*
!.env.example
!.env.*.example

# 日志
*.log
logs/

# Web 依赖、构建产物及缓存；package-lock.json 保留
node_modules/
/apps/web/dist/
/apps/web/.vite/
/apps/web/.cache/
/apps/web/coverage/
/apps/web/test-results/
/apps/web/playwright-report/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# iOS / Xcode 本机状态及构建产物；工程、共享 Scheme 与资源保留
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
/apps/iOS/build/
/apps/iOS/DerivedData/
*.xcresult/
*.xcarchive/
*.ipa
*.dSYM/

# Go 构建产物、性能分析与覆盖率
/backend/bin/
/backend/build/
/backend/dist/
/backend/.tmp-go-cache/
/backend/vendor/
/backend/coverage/
/backend/coverage.out
/backend/*.test
/backend/*.prof
/backend/*.pprof

# 后端本机配置和运行数据；config.example.yaml 保留
/backend/config.yaml
/backend/data/
/backend/log/
/backend/*.db
/backend/*.db-shm
/backend/*.db-wal
/backend/*.sqlite
/backend/*.sqlite-shm
/backend/*.sqlite-wal
/backend/*.sqlite3
/backend/*.sqlite3-shm
/backend/*.sqlite3-wal

# Python 工具脚本缓存与虚拟环境
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# 移植前的本机备份
/.migration-backup/
